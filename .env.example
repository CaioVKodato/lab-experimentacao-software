# Token do GitHub para consultas GraphQL (não versionar o .env real)
# Coleta de repos públicos: classic com public_repo
# Snapshot do Kanban: classic também precisa de read:project
GITHUB_TOKEN=ghp_seu_token_aqui

# Opcional — padrão = Project do grupo
# GITHUB_PROJECT_OWNER=CaioVKodato
# GITHUB_PROJECT_NUMBER=6
# GITHUB_PROJECT_STATUS_FIELD=Status
